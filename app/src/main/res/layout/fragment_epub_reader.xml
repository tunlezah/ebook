<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg_light">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Blue light filter overlay -->
    <View
        android:id="@+id/blueLightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_light_overlay"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Top toolbar (shown/hidden on center tap) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/reader_chrome_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_reader_back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/reader_chrome_foreground" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:textColor="@color/reader_chrome_foreground"
            android:textSize="@dimen/text_subtitle"
            tools:text="Book Title" />

        <ImageButton
            android:id="@+id/btnChapters"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_reader_toc"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/reader_chrome_foreground" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_reader_settings"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/reader_chrome_foreground" />

    </LinearLayout>

    <!-- Bottom bar with progress -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/reader_chrome_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/chapterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/reader_chrome_foreground_subtle"
            android:textSize="@dimen/text_caption"
            tools:text="Chapter 3 of 24" />

        <SeekBar
            android:id="@+id/progressSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/cd_reader_progress"
            android:max="100"
            android:paddingHorizontal="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/reader_chrome_foreground_subtle"
            android:textSize="@dimen/text_caption"
            tools:text="45%" />

    </LinearLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
