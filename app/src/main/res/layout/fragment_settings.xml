<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/settings_title"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Appearance Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/settings_appearance"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <!-- Theme -->
        <LinearLayout
            android:id="@+id/themeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_theme"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/themeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorSecondary"
                android:textSize="@dimen/text_subtitle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- No Animations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_no_animations"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNoAnimations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Low Memory Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_low_memory"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLowMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Reading Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/settings_reading"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <!-- Font -->
        <LinearLayout
            android:id="@+id/fontRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_font"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/fontValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorSecondary"
                android:textSize="@dimen/text_subtitle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Font Size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_font_size"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <SeekBar
                android:id="@+id/fontSizeSeekBar"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:max="24"
                android:progress="6" />

            <TextView
                android:id="@+id/fontSizeValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:textColorSecondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Line Spacing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_line_spacing"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <SeekBar
                android:id="@+id/lineSpacingSeekBar"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="4" />

            <TextView
                android:id="@+id/lineSpacingValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?android:textColorSecondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Blue Light Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_blue_light"
                android:textColor="?android:textColorPrimary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlueLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Storage Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/settings_storage"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <!-- Clear Cache -->
        <TextView
            android:id="@+id/clearCacheRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:selectableItemBackground"
            android:paddingVertical="@dimen/spacing_md"
            android:text="@string/settings_clear_cache"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/text_body" />

        <!-- About Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/settings_about"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/spacing_md"
            android:textColor="?android:textColorSecondary"
            android:textSize="@dimen/text_subtitle" />

    </LinearLayout>

</ScrollView>
